# beebots settings. Most people need NONE of this: the Setup page asks for your keys when you first open the site.
# Copy to .env (next to docker-compose.yml) only if you want to change something. NEVER commit .env.

# ---- Mode -------------------------------------------------------------------
# dry  = PAPER TRADING (the default): real market prices, simulated money, no exchange account needed
# demo = exchange demo/testnet with per-bee keys (OKX demo keys, or Hyperliquid testnet API wallets)
# live = REAL MONEY. Needs DRY_RUN=false, MODE=live, per-bee LIVE keys AND LIVE_ACK below. Not financial advice.
MODE=dry
# Safety latch. true (the default, also when unset) forces paper trading whatever MODE says.
DRY_RUN=true
# Only for MODE=live: must be exactly I-ACCEPT-REAL-MONEY-RISK. You can lose everything you put in.
LIVE_ACK=

# ---- Setup ------------------------------------------------------------------
# The Setup page stays open this many minutes after the engine starts. First come, first served: once saved it closes
# for good. If nobody finishes in time, restart the engine container to open it again.
SETUP_WINDOW_MIN=120
# The owner password is picked on Setup and stored as a hash. Set this only if your Setup file has none (an install
# from before it existed, or keys set only here). At least 8 characters. Gates Join/Leave the Hive on the dashboard.
OWNER_PASSWORD=

# ---- Decisions: Gemini 4 Argon (or Jev) -------------------------------------
# Who picks each bee's next move. Setup asks for one key; anything set here wins over Setup.
#   GEMINI_API_KEY set           -> Gemini 4 Argon (wins if both keys are set)
#   only TYPESAFE_API_KEY set    -> Jev
#   neither                      -> a deterministic code chooser (paper and demo only; MODE=live refuses to start)
# Over the daily cap, or when the model is down or answers off the menu, the code chooser answers until it is back.
# It does not read a bee's free-text rules (coin limits and the risk layer still apply). Stops and caps are code.

# Gemini 4 Argon. Key from Google AI Studio (https://aistudio.google.com/apikey), in a project with billing on:
# the free tier cannot use Argon. README: "Run it with Gemini 4 Argon".
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-argon
GEMINI_TIMEOUT_MS=3000
# Daily Gemini spend cap in USD as the engine counts it, for all three bees together. Each call reserves its worst case
# before it is sent; a call that does not fit is not sent (the code chooser answers, and the dashboard says so).
GEMINI_DAILY_USD_CAP=3
# USD per million tokens, input and output (thinking counts as output). Both must be above 0. The defaults are Argon's
# price after the launch offer ($4 / $20). Until 30 Nov 2026 the launch price is $2 / $10 (announced by Google on
# 13 Oct 2026), so until then the counter prices tokens at twice the billed rate. Check Google's pricing page.
GEMINI_USD_PER_MTOK=4
GEMINI_USD_PER_MTOK_OUT=20
# At most one paid call per bee per this many ms, whatever TICK_MS is. In between, the bee keeps what it has.
GEMINI_MIN_INTERVAL_MS=60000
# Optional thinkingConfig.thinkingLevel (blank = the model's default).
GEMINI_THINKING_LEVEL=

# Jev (TypeSafe AI). Key from https://console.typesafe.ai/keys
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
JEV_TIMEOUT_MS=2000
# Daily Jev spend threshold in USD (soft): no new Jev call once today's spend plus the calls in flight would pass it.
# Jev bills by its own token count, so calls already in flight can take a day somewhat over it. JEV_USD_PER_MTOK must be
# above 0.
JEV_DAILY_USD_CAP=2

# How often each bee is looked at (ms): stops, caps and the code chooser run every tick. Jev is asked every tick
# (10000 = 18 decisions/min for three bees, about $0.90/day, docs/COSTS.md); Gemini at most every GEMINI_MIN_INTERVAL_MS.
TICK_MS=10000
# Full market refresh (candles, indicators, funding, OI): every 60 s
DATA_REFRESH_MS=60000

# ---- OpenAI (optional) --------------------------------------------------------
# Setup asks for this too (required there). Used only on the Setup page: design each bee from a sentence, and paint it.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.4-nano
OPENAI_IMAGE_MODEL=gpt-image-2

# ---- OKX (EEA) --------------------------------------------------------------
# Market data comes from OKX's public EEA API. Demo/live keys must be EEA (my.okx.com) keys.
OKX_API_BASE=https://eea.okx.com

# Demo or live only: one OKX sub-account per bee. Keys: Read + Trade ONLY. Never Withdraw, never Transfer.
# Live keys should be IP-bound to your server. Demo keys come from OKX's demo-trading screen.
BEE1_OKX_DEMO_API_KEY=
BEE1_OKX_DEMO_API_SECRET=
BEE1_OKX_DEMO_API_PASSPHRASE=
BEE2_OKX_DEMO_API_KEY=
BEE2_OKX_DEMO_API_SECRET=
BEE2_OKX_DEMO_API_PASSPHRASE=
BEE3_OKX_DEMO_API_KEY=
BEE3_OKX_DEMO_API_SECRET=
BEE3_OKX_DEMO_API_PASSPHRASE=
BEE1_OKX_API_KEY=
BEE1_OKX_API_SECRET=
BEE1_OKX_API_PASSPHRASE=
BEE2_OKX_API_KEY=
BEE2_OKX_API_SECRET=
BEE2_OKX_API_PASSPHRASE=
BEE3_OKX_API_KEY=
BEE3_OKX_API_SECRET=
BEE3_OKX_API_PASSPHRASE=

# ---- Hyperliquid (optional) ---------------------------------------------------
# Leave EXCHANGE=okx (the default) to keep trading OKX. hyperliquid switches market data and, in demo/live, orders.
# Paper (MODE=dry, the default) uses live Hyperliquid prices and simulated money. No wallet, no orders.
# MODE=demo trades Hyperliquid TESTNET with the BEE*_HL_TESTNET_* wallets below. It cannot be pointed at mainnet.
# Real Hyperliquid money needs all of: EXCHANGE=hyperliquid, HL_NETWORK=mainnet, DRY_RUN=false, MODE=live,
# LIVE_ACK, and the BEE*_HL_ACCOUNT / BEE*_HL_AGENT_KEY variables (separate from the testnet ones).
# README: "Run on Hyperliquid testnet".
EXCHANGE=okx
# testnet is the default. mainnet is the only value that allows real Hyperliquid orders, and only with MODE=live.
HL_NETWORK=testnet
# How far through the book an IOC "market" order may reach, in basis points (100 = 1%). Hard cap 500 (5%).
HL_IOC_SLIPPAGE_BPS=100
# Busiest coins that get a real bid/ask. The rest are not opened (they fail the spread check). 1 to 40.
HL_BOOK_COINS=24

# Testnet only (MODE=demo). One API wallet per bee. The account is the master address (queries).
# The agent key signs orders and cannot withdraw. Never commit either value.
BEE1_HL_TESTNET_ACCOUNT=
BEE1_HL_TESTNET_AGENT_KEY=
BEE2_HL_TESTNET_ACCOUNT=
BEE2_HL_TESTNET_AGENT_KEY=
BEE3_HL_TESTNET_ACCOUNT=
BEE3_HL_TESTNET_AGENT_KEY=
# Mainnet only (MODE=live AND HL_NETWORK=mainnet). Different names so a testnet key cannot sign mainnet.
BEE1_HL_ACCOUNT=
BEE1_HL_AGENT_KEY=
BEE2_HL_ACCOUNT=
BEE2_HL_AGENT_KEY=
BEE3_HL_ACCOUNT=
BEE3_HL_AGENT_KEY=

# ---- Risk (every bee) ---------------------------------------------------------
BEE_START_EQUITY_USD=333
MAX_LEVERAGE=2
# Per-bee daily loss stop, % of that bee's equity at 00:00 UTC. Trip = flat until 00:00 UTC.
DAILY_LOSS_STOP_PCT=8
# If a bee's equity falls below this % of its start, it retires for good.
BEE_RETIRE_AT_PCT=40
# Hard ceiling on any bee's position size, whatever its balance says
MAX_NOTIONAL_USD_PER_BEE=700
# "Never flat for long" ceiling in minutes. Each style's own limit is min(its own, this). Since Gemini 4 Argon's
# rewrite no style is ever forced in, so this only matters for brains you write yourself.
MAX_FLAT_MINUTES=1440
# First hours of live trading run at reduced size
LIVE_SIZE_MULTIPLIER=0.25
LIVE_RAMP_HOURS=2
MIN_24H_VOL_USD=1000000
ALLOW_NON_CRYPTO=false

# ---- Per-style knobs ------------------------------------------------------------
# BIZZY_* = Breakout, BREEZY_* = Trend, BOOZY_* = Momentum. Every bee on that style uses them.
# See strategies/*.md. COOLDOWN_MINUTES: wait after an order. STOP_ATR_MULT: stop distance in ATR(14).
# The values below are the defaults (Gemini 4 Argon's rules, strategies/ARGON_INTENDED.json). A value set in your .env
# beats the default even after an update: `pnpm effective-config .env --diff strategies/ARGON_INTENDED.json` lists them.
BREEZY_MAX_TRADES_PER_DAY=2
BREEZY_FEE_BUDGET_USD_DAY=0.75
BREEZY_MIN_OPEN_PROB=0.55
BREEZY_MIN_SIZE_USD=10
BREEZY_SPREAD_GATE_BPS=5
BREEZY_COOLDOWN_MINUTES=240
BREEZY_STOP_ATR_MULT=2
BREEZY_MAX_FLAT_MINUTES=1440

BIZZY_MAX_TRADES_PER_DAY=4
BIZZY_FEE_BUDGET_USD_DAY=1.20
BIZZY_SIZE_FRACTION=0.5
BIZZY_UNIVERSE_SIZE=8
BIZZY_MAX_FLAT_MINUTES=1440
BIZZY_SPREAD_GATE_BPS=5
BIZZY_COOLDOWN_MINUTES=30
BIZZY_STOP_ATR_MULT=2
BIZZY_TIME_STOP_MINUTES=240

BOOZY_MAX_TRADES_PER_DAY=3
BOOZY_FEE_BUDGET_USD_DAY=1.50
BOOZY_SPREAD_GATE_BPS=8
BOOZY_CANDIDATES=5
BOOZY_COOLDOWN_MINUTES=60
BOOZY_STOP_ATR_MULT=2.5
BOOZY_MAX_FLAT_MINUTES=1440

# ---- Server -------------------------------------------------------------------
# A domain pointed at this server gets automatic HTTPS. Blank = plain HTTP on the server's IP.
PUBLIC_DOMAIN=
LOG_LEVEL=info
# Alerts (optional): a Telegram bot, ntfy.sh topic or any webhook URL. Cap trips, decision-model outages, restarts.
ALERT_WEBHOOK_URL=
# The Hive: the public paper-trading leaderboard. Nothing is sent unless you join (on Setup or from the dashboard).
HIVE_URL=https://beebots.tech
# ---- The Beekeeper (optional) -------------------------------------------------
# A Zap on Zapier that may rewrite one bee's rules when they stop working. See docs/BEEKEEPER.md.
# Most people set NONE of these: connect it from the dashboard instead. Anything set here wins over the dashboard.
# Your beebots starts every round itself. It sends the Zap its own address and a 15-minute key, so the Zap holds
# no secret and no address.
# The Catch Hook URL from step 1 of your Zap. Must start with https://. Treat it like a password.
BEEKEEPER_WEBHOOK_URL=
# Where the Zap finds this server, like https://bees.example.com or http://your-server-ip (no path).
# Blank = https://<PUBLIC_DOMAIN> when that is set, else the address you connected from.
PUBLIC_URL=
# Hours between rounds. Blank = 4. Each round costs Zapier tasks (see docs/BEEKEEPER.md).
BEEKEEPER_EVERY_HOURS=
# Optional warm-up. Set a start time (like 2026-10-02T13:00:00Z) and rounds run hourly for 12 h,
# then every 2 h for 12 h, then every 3 h for 12 h, then every BEEKEEPER_EVERY_HOURS.
BEEKEEPER_RAMP_START=

# "Update available" on the dashboard when a newer GitHub Release is out. It never installs anything by itself.
UPDATE_CHECK=true
# Dashboard links: the "Hosted on" chip and the code link.
HOST_LINK=https://mrc.fm/beebots
REPO_LINK=https://github.com/imikerussell/beebots
